# .env.ai.example — шаблон конфигурации AI-gateway
# Скопируй в .env.ai и заполни значения
# chmod 600 .env.ai
# ДОБАВЬ .env.ai в .gitignore!

# ═══════════════════════════════════════════════════════════════════
# Anthropic API — ПРОИЗВОДСТВЕННЫЙ AI в приложении
# (отдельный ключ от того, что использует Claude Code для разработки)
# ═══════════════════════════════════════════════════════════════════

# Получи в console.anthropic.com → API Keys
# Рекомендую отдельный ключ с именем "genomeai-production-ai"
ANTHROPIC_API_KEY=sk-ant-api03-ВСТАВЬ_СЮДА_КЛЮЧ

# ═══════════════════════════════════════════════════════════════════
# Модели Claude для разных задач
# ═══════════════════════════════════════════════════════════════════

# Дефолтная модель для большинства запросов
GENOMEAI_AI_DEFAULT_MODEL=claude-sonnet-4-6

# Премиум-модель для важных задач (morning brief, weekly brief)
GENOMEAI_AI_OPUS_MODEL=claude-opus-4-7

# Быстрая и дешёвая для простых задач (валидация, форматирование)
GENOMEAI_AI_HAIKU_MODEL=claude-haiku-4-5

# Для каких задач использовать Opus (запятая-список):
GENOMEAI_AI_USE_OPUS_FOR=morning_brief,weekly_brief

# ═══════════════════════════════════════════════════════════════════
# Кэширование (Redis)
# ═══════════════════════════════════════════════════════════════════

GENOMEAI_AI_ENABLE_CACHE=true
GENOMEAI_AI_CACHE_TTL_SECONDS=300

# Redis connection (используем тот же что web_cabinet)
REDIS_URL=redis://127.0.0.1:6379/0

# ═══════════════════════════════════════════════════════════════════
# Rate limiting (защита от runaway бюджета)
# ═══════════════════════════════════════════════════════════════════

# На одного пользователя
GENOMEAI_AI_RATE_LIMIT_PER_MIN=60
GENOMEAI_AI_RATE_LIMIT_PER_HOUR=500

# Глобально на всю систему (чтобы не превысить budget)
GENOMEAI_AI_GLOBAL_RATE_LIMIT_PER_HOUR=2000

# ═══════════════════════════════════════════════════════════════════
# Бюджет
# ═══════════════════════════════════════════════════════════════════

# Максимум долларов в месяц на production AI (отдельно от Claude Code)
# При превышении — AI отключается, log warning
GENOMEAI_AI_MONTHLY_BUDGET_USD=50

# ═══════════════════════════════════════════════════════════════════
# Демо-режим (для инвесторского показа)
# ═══════════════════════════════════════════════════════════════════

# Если true — AI использует кэшированные "идеальные" ответы
# на preset-вопросы для гарантированного качества на демо
GENOMEAI_AI_DEMO_MODE=true

# Preset-вопросы которые кэшируются
GENOMEAI_AI_DEMO_PRESET_QUESTIONS=why_star_milk_drop,which_to_cull,cows_in_heat_today

# ═══════════════════════════════════════════════════════════════════
# Observability
# ═══════════════════════════════════════════════════════════════════

# Логи всех LLM calls в JSON
GENOMEAI_AI_LOG_LEVEL=INFO
GENOMEAI_AI_LOG_FORMAT=json

# Путь к log файлу
GENOMEAI_AI_LOG_PATH=/var/log/genomeai-ai/ai-gateway.log

# ═══════════════════════════════════════════════════════════════════
# Ферма / демо
# ═══════════════════════════════════════════════════════════════════

# ID демо-фермы
GENOMEAI_DEMO_FARM_ID=demo-farm-v1

# Имя помощника в UI (на русском!)
GENOMEAI_AI_ASSISTANT_NAME=ИИ-помощник

# Часовой пояс (для утренних брифингов)
GENOMEAI_TIMEZONE=Europe/Moscow

# ═══════════════════════════════════════════════════════════════════
# Cron задачи (в формате cron)
# ═══════════════════════════════════════════════════════════════════

# Утренний брифинг — каждый день в 06:00 MSK
GENOMEAI_AI_MORNING_BRIEF_CRON=0 6 * * *

# Сканер инсайтов — каждые 6 часов
GENOMEAI_AI_INSIGHT_SCANNER_CRON=0 */6 * * *

# Weekly briefing — понедельник 07:00
GENOMEAI_AI_WEEKLY_BRIEF_CRON=0 7 * * 1

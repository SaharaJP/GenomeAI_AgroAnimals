        ('idx_alerts_v2_type', 'alerts_v2'),
        ('idx_alerts_v2_tenant_status', 'alerts_v2'),
        ('idx_audit_log_tenant_run', 'audit_log'),
        ('idx_audit_log_tenant_object', 'audit_log'),
        ('idx_audit_log_tenant_action', 'audit_log'),
        ('idx_audit_log_tenant_ts', 'audit_log'),
        ('idx_jobs_data_version', 'jobs'),
        ('idx_jobs_run_id', 'jobs'),
        ('idx_jobs_status_created', 'jobs'),
    ]:
        op.drop_index(index_name, table_name=table_name)
    for table in [
        'connector_schedule_state', 'connector_runs', 'report_approvals_v1', 'whatif_reports_v1',
        'whatif_scenarios_v1', 'favorites_v1', 'report_templates_v1', 'saved_views_v1',
        'tasks_v1', 'decision_log_v2', 'alerts_v2', 'audit_log', 'jobs'
    ]:
        op.drop_table(table)

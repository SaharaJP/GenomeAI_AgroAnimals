class RunsRepo(BaseSqlRepo):
    def get_job(self, job_id: int) -> Optional[dict[str, Any]]:
        row = self.conn.execute("SELECT * FROM jobs WHERE id=?", (int(job_id),)).fetchone()
        return dict(row) if row else None

    def list_jobs_filtered(self, *, status: str | None = None, pipeline: str | None = None, q: str | None = None, limit: int = 200, active_statuses: Iterable[str] = ()) -> list[dict[str, Any]]:
        sql = "SELECT * FROM jobs WHERE 1=1"
        args: list[Any] = []
        if status:
            raw_status = str(status).strip()
            if raw_status == "active":
                active_statuses = list(active_statuses)
                placeholders = self._ph(len(active_statuses))
                sql += f" AND status IN ({placeholders})"
                args.extend(active_statuses)
            else:
                sql += " AND status=?"
                args.append(raw_status)
        if pipeline:
            sql += " AND (pipeline_key=? OR kind=?)"
            args.extend([str(pipeline).strip(), str(pipeline).strip()])
        if q:
            term = f"%{str(q).strip()}%"
            sql += (
                " AND (public_job_id LIKE ? OR run_id LIKE ? OR data_version LIKE ? OR command LIKE ? OR user LIKE ? "
                "OR pipeline_key LIKE ? OR kind LIKE ? OR qc_run LIKE ? OR model_version LIKE ? OR scoring_run LIKE ? "
                "OR report_version LIKE ? OR retry_source LIKE ? OR error_text LIKE ?)"
            )
            args.extend([term] * 13)
        sql += " ORDER BY id DESC LIMIT ?"
        args.append(max(1, min(int(limit or 200), 1000)))
        rows = self.conn.execute(sql, tuple(args)).fetchall()
        return [dict(r) for r in rows]

    def list_job_family(self, job_id: int) -> list[dict[str, Any]]:
        current = self.get_job(job_id)
        if not current:
            return []
        root_id = int(current.get("id") or job_id)
        seen: set[int] = set()
        while current and current.get("retry_of_job_id") and int(current.get("retry_of_job_id")) not in seen:
            seen.add(root_id)
            root_id = int(current.get("retry_of_job_id"))
            current = self.get_job(root_id)
        rows = self.conn.execute(
            "SELECT * FROM jobs WHERE id=? OR retry_of_job_id=? OR id IN (SELECT id FROM jobs WHERE retry_of_job_id=?) ORDER BY id ASC",
            (root_id, root_id, root_id),
        ).fetchall()
        return [dict(r) for r in rows]


@dataclass
class ArtifactsRepo:
    project_root: Path
    artifacts_root: Path
    storage_root: Path

    def __post_init__(self) -> None:
        self.project_root = Path(self.project_root).resolve()
        self.artifacts_root = Path(self.artifacts_root).resolve()
        self.storage_root = Path(self.storage_root).resolve()

    def _root_map(self) -> dict[str, Path]:
        return {
            "artifacts": self.artifacts_root,
            "web_storage": self.storage_root,
            "project": self.project_root,
        }

    def resolve_virtual_path(self, path: str) -> tuple[Path, str]:
        from web_cabinet.utils import safe_join

        rel = str(path or "").lstrip("/")
        base = self.project_root
        rel2 = rel
        for prefix, root in self._root_map().items():
            if rel == prefix or rel.startswith(prefix + "/"):
                base = root
                rel2 = rel[len(prefix):].lstrip("/")
                break
        if not rel2:
            raise ValueError("empty path")
        resolved = safe_join(base, rel2)
        if not resolved.exists() or not resolved.is_file():
            raise FileNotFoundError(str(resolved))
        return resolved, rel

    def read_json(self, path: Path) -> dict[str, Any]:
        payload = json.loads(Path(path).read_text(encoding="utf-8"))
        if not isinstance(payload, dict):
            raise ValueError("artifact_json_must_be_object")
        return payload

    def read_json_virtual(self, path: str) -> dict[str, Any]:
        resolved, _ = self.resolve_virtual_path(path)
        return self.read_json(resolved)

    def read_yaml(self, path: Path) -> dict[str, Any]:
        payload = yaml.safe_load(Path(path).read_text(encoding="utf-8")) or {}
        return payload if isinstance(payload, dict) else {}

    def list_files_recursive(self, path: Path | None, *, limit: int = 200) -> list[Path]:
        fp = Path(path) if path is not None else None
        if fp is None or not fp.exists():
            return []
        if fp.is_file():
            return [fp]
        files = [x for x in fp.rglob('*') if x.is_file()]
        return sorted(files)[: max(1, int(limit or 1))]

    def read_preview(self, path: Path, *, max_bytes: int = 65536) -> tuple[str, bool]:
        raw = Path(path).read_bytes()
        truncated = len(raw) > max_bytes
        body = raw[:max_bytes]
        text = body.decode("utf-8", errors="ignore")
        if truncated:
            text += "\n... <preview truncated> ..."
        return text, truncated

    def read_jsonl_objects(self, path: Path | None, *, limit: int = 200) -> list[dict[str, Any]]:
        if path is None or not Path(path).exists() or not Path(path).is_file():
            return []
        rows: list[dict[str, Any]] = []
        try:
            with Path(path).open('r', encoding='utf-8') as f:
                for idx, line in enumerate(f):
                    if idx >= max(1, int(limit or 1)):
                        break
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        obj = json.loads(line)
                    except Exception:
                        continue
                    if isinstance(obj, dict):
                        rows.append(obj)
        except Exception:
            return []
        return rows

    def preview_virtual(self, path: str, *, max_bytes: int) -> tuple[str, bool]:
        resolved, _ = self.resolve_virtual_path(path)
        return self.read_preview(resolved, max_bytes=max_bytes)

    def read_text(self, path: Path) -> str:
        return Path(path).read_text(encoding="utf-8")

    def read_bytes_tail(self, path: Path, *, max_bytes: int) -> dict[str, Any]:
        raw = Path(path).read_bytes()
        size = len(raw)
        max_tail = max(1024, min(int(max_bytes), 1024 * 1024))
        body = raw[-max_tail:]
        return {"size_bytes": size, "tail_bytes": len(body), "is_truncated": size > len(body), "text": body.decode("utf-8", errors="ignore")}

    def read_stream(self, path: Path, *, cursor: int = 0, max_bytes: int = 65536) -> dict[str, Any]:
        fp = Path(path)
        if not fp.exists() or not fp.is_file():
            return {"cursor": max(0, int(cursor or 0)), "next_cursor": max(0, int(cursor or 0)), "max_bytes": 0, "size_bytes": 0, "text": "", "is_eof": True}
        raw = fp.read_bytes()
        size = len(raw)
        start = max(0, min(int(cursor or 0), size))
        chunk_limit = max(1, min(int(max_bytes or 65536), 1024 * 1024))
        body = raw[start:start + chunk_limit]
        next_cursor = start + len(body)
        return {"cursor": start, "next_cursor": next_cursor, "max_bytes": chunk_limit, "size_bytes": size, "text": body.decode("utf-8", errors="ignore"), "is_eof": next_cursor >= size}

    def ensure_dir(self, path: Path) -> Path:
        p = Path(path)
        p.mkdir(parents=True, exist_ok=True)
        return p

    def write_json(self, path: Path, payload: dict[str, Any]) -> Path:
        p = Path(path)
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        return p

    def write_dataframe_csv(self, path: Path, df: pd.DataFrame) -> Path:
        p = Path(path)
        p.parent.mkdir(parents=True, exist_ok=True)
        df.to_csv(p, index=False)
        return p


class PlaybooksRepo(BaseSqlRepo):
    @staticmethod
    def _decode_version_row(row: Any) -> Optional[dict[str, Any]]:
        if not row:
            return None
        d = dict(row)
        try:
            d["steps"] = json.loads(d.get("steps_json") or "[]")
        except Exception:
            d["steps"] = []
        d.pop("steps_json", None)
        return d

    def create_version(
        self,
        *,
        tenant_id: str,
        version_id: str,
        playbook_key: str,
        target_kind: str,
        target_type: str,
        farm_id: str,
        name: str,
        description: str | None,
        steps: list[dict[str, Any]],
        created_at: str,
        created_by: int | None,
        created_by_username: str | None,
        comment: str | None,
    ) -> str:
        self.conn.execute(
            """
            INSERT INTO playbook_versions(
              version_id, tenant_id,
              playbook_key, target_kind, target_type, farm_id,
              name, description, steps_json,
              created_at, created_by, created_by_username, comment
            ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)
            """,
            (
                version_id, tenant_id, playbook_key, target_kind, target_type, farm_id,
                name, description, json.dumps(steps, ensure_ascii=False),
                created_at, created_by, created_by_username, comment,
            ),
        )
        self.conn.commit()
        return version_id

    def get_version(self, *, tenant_id: str, version_id: str) -> Optional[dict[str, Any]]:
        row = self.conn.execute(
            "SELECT * FROM playbook_versions WHERE tenant_id=? AND version_id=?",
            (tenant_id, version_id),
        ).fetchone()
        return self._decode_version_row(row)

    def list_versions(
        self,
        *,
        tenant_id: str,
        target_kind: str | None = None,
        target_type: str | None = None,
        farm_id: str | None = None,
        limit: int = 200,
        offset: int = 0,
    ) -> list[dict[str, Any]]:
        sql = "SELECT * FROM playbook_versions WHERE tenant_id=?"
        args: list[Any] = [tenant_id]
        if target_kind:
            sql += " AND target_kind=?"
            args.append(target_kind)
        if target_type:
            sql += " AND target_type=?"
            args.append(target_type)
        if farm_id is not None:
            sql += " AND farm_id=?"
            args.append(farm_id)
        sql += " ORDER BY created_at DESC LIMIT ? OFFSET ?"
        args.extend([max(1, int(limit or 200)), max(0, int(offset or 0))])
        rows = self.conn.execute(sql, tuple(args)).fetchall()
        return [self._decode_version_row(r) for r in rows if r]

    def get_active_version_mapping(self, *, tenant_id: str, playbook_key: str, farm_id: str) -> dict[str, Any]:
        row = self.conn.execute(
            "SELECT active_version_id FROM playbooks_active WHERE tenant_id=? AND playbook_key=? AND farm_id=?",
            (tenant_id, playbook_key, farm_id),
        ).fetchone()
        return dict(row) if row else {"active_version_id": None}

    def list_active_candidates(self, *, tenant_id: str, playbook_key: str, farm_id: str) -> list[dict[str, Any]]:
        rows = self.conn.execute(
            "SELECT active_version_id, farm_id FROM playbooks_active WHERE tenant_id=? AND playbook_key=? AND farm_id IN (?, '') ORDER BY CASE WHEN farm_id=? THEN 0 ELSE 1 END",
            (tenant_id, playbook_key, farm_id, farm_id),
        ).fetchall()
        return [dict(r) for r in rows]

    def set_active_version(self, *, tenant_id: str, playbook_key: str, farm_id: str, version_id: str, updated_at: str) -> None:
        self.conn.execute(
            """
            INSERT INTO playbooks_active(tenant_id, playbook_key, farm_id, active_version_id, updated_at)
            VALUES(?,?,?,?,?)
            ON CONFLICT(tenant_id, playbook_key, farm_id) DO UPDATE SET
              active_version_id=excluded.active_version_id,
              updated_at=excluded.updated_at
            """,
            (tenant_id, playbook_key, farm_id, version_id, updated_at),
        )
        self.conn.commit()


class ConnectorRunsRepo(BaseSqlRepo):
    def ensure_tables(self) -> None:
        self.conn.executescript(
            """
            CREATE TABLE IF NOT EXISTS connector_runs (
              id INTEGER PRIMARY KEY AUTOINCREMENT,
              connector_run_id TEXT NOT NULL UNIQUE,
              tenant_id TEXT NOT NULL,
              connector_id TEXT NOT NULL,
              kind TEXT NOT NULL,
              trigger_type TEXT NOT NULL,
              schedule_slot TEXT,
              status TEXT NOT NULL,
              created_at TEXT NOT NULL,
              started_at TEXT NOT NULL,
              finished_at TEXT,
              data_version TEXT,
              message TEXT,
              config_path TEXT,
              outputs_json TEXT NOT NULL DEFAULT '{}',
              selected_files_json TEXT NOT NULL DEFAULT '[]',
              ingest_summaries_json TEXT NOT NULL DEFAULT '[]',
              error_text TEXT
            );
            CREATE INDEX IF NOT EXISTS idx_connector_runs_connector ON connector_runs(tenant_id, connector_id, started_at DESC);
            CREATE INDEX IF NOT EXISTS idx_connector_runs_status ON connector_runs(status, started_at DESC);

            CREATE TABLE IF NOT EXISTS connector_schedule_state (
              tenant_id TEXT NOT NULL,
              connector_id TEXT NOT NULL,
              last_slot TEXT,
              last_enqueued_at TEXT,
              last_job_id INTEGER,
              PRIMARY KEY(tenant_id, connector_id)
            );
            """
        )
        self.conn.commit()

    @staticmethod
    def decode_run_row(row: Any) -> Optional[dict[str, Any]]:
        if not row:
            return None
        item = dict(row)
        for key in ("outputs_json", "selected_files_json", "ingest_summaries_json"):
            try:
                item[key[:-5]] = json.loads(item.get(key) or ("{}" if key == "outputs_json" else "[]"))
            except Exception:
                item[key[:-5]] = {} if key == "outputs_json" else []
        return item

    def start_run(
        self,
        *,
        tenant_id: str,
        connector_run_id: str,
        connector_id: str,
        kind: str,
        trigger_type: str,
        schedule_slot: str | None,
        config_path: str,
        started_at: str,
    ) -> None:
        self.ensure_tables()
        self.conn.execute(
            """
            INSERT OR REPLACE INTO connector_runs(
              connector_run_id, tenant_id, connector_id, kind, trigger_type, schedule_slot,
              status, created_at, started_at, config_path
            ) VALUES(?,?,?,?,?,?,?,?,?,?)
            """,
            (connector_run_id, tenant_id, connector_id, kind, trigger_type, schedule_slot, "running", started_at, started_at, config_path),
        )
        self.conn.commit()

    def finish_run(
        self,
        *,
        tenant_id: str,
        connector_run_id: str,
        status: str,
        finished_at: str,
        data_version: str | None,
        message: str,
        outputs: dict[str, Any],
        selected_files: list[dict[str, Any]],
        ingest_summaries: list[dict[str, Any]],
        error_text: str | None = None,
    ) -> None:
        self.ensure_tables()
        self.conn.execute(
            """
            UPDATE connector_runs
               SET tenant_id=?,
                   status=?,
                   finished_at=?,
                   data_version=?,
                   message=?,
                   outputs_json=?,
                   selected_files_json=?,
                   ingest_summaries_json=?,
                   error_text=?
             WHERE connector_run_id=?
            """,
            (tenant_id, status, finished_at, data_version, message, json.dumps(outputs or {}, ensure_ascii=False), json.dumps(selected_files or [], ensure_ascii=False), json.dumps(ingest_summaries or [], ensure_ascii=False), error_text, connector_run_id),
        )
        self.conn.commit()

    def get_run(self, *, tenant_id: str, connector_run_id: str) -> Optional[dict[str, Any]]:
        self.ensure_tables()
        row = self.conn.execute(
            "SELECT * FROM connector_runs WHERE tenant_id=? AND connector_run_id=?",
            (tenant_id, str(connector_run_id).strip()),
        ).fetchone()
        return self.decode_run_row(row)

    def list_runs(self, *, tenant_id: str, connector_id: str | None = None, limit: int = 100) -> list[dict[str, Any]]:
        self.ensure_tables()
        sql = "SELECT * FROM connector_runs WHERE tenant_id=?"
        args: list[Any] = [tenant_id]
        if connector_id:
            sql += " AND connector_id=?"
            args.append(str(connector_id).strip())
        sql += " ORDER BY id DESC LIMIT ?"
        args.append(max(1, min(int(limit or 100), 500)))
        rows = self.conn.execute(sql, tuple(args)).fetchall()
        return [self.decode_run_row(r) for r in rows if r]

    def get_schedule_state(self, *, tenant_id: str, connector_id: str) -> dict[str, Any] | None:
        self.ensure_tables()
        row = self.conn.execute(
            "SELECT tenant_id, connector_id, last_slot, last_enqueued_at, last_job_id FROM connector_schedule_state WHERE tenant_id=? AND connector_id=?",
            (tenant_id, connector_id),
        ).fetchone()
        return dict(row) if row else None

    def set_schedule_state(self, *, tenant_id: str, connector_id: str, last_slot: str, last_job_id: int | None, last_enqueued_at: str) -> None:
        self.ensure_tables()
        self.conn.execute(
            """
            INSERT INTO connector_schedule_state(tenant_id, connector_id, last_slot, last_enqueued_at, last_job_id)
            VALUES(?,?,?,?,?)
            ON CONFLICT(tenant_id, connector_id) DO UPDATE SET
              last_slot=excluded.last_slot,
              last_enqueued_at=excluded.last_enqueued_at,
              last_job_id=excluded.last_job_id
            """,
            (tenant_id, connector_id, last_slot, last_enqueued_at, last_job_id),
        )
        self.conn.commit()

    def list_pending_jobs(self, *, tenant_id: str, config_path: str, limit: int = 25, parser: Any | None = None) -> list[dict[str, Any]]:
        normalized_config = str(Path(config_path).resolve())
        rows = self.conn.execute(
            "SELECT id, public_job_id, kind, status, created_at, next_attempt_at, retry_source, args_json FROM jobs WHERE tenant_id=? AND kind='connector_run' AND status='queued' ORDER BY id DESC LIMIT ?",
            (tenant_id, max(1, min(int(limit or 25), 200))),
        ).fetchall()
        out: list[dict[str, Any]] = []
        for row in rows:
            item = dict(row)
            try:
                args = json.loads(item.get('args_json') or '{}')
            except Exception:
                args = {}
            parsed = parser(list((args or {}).get('argv') or [])) if parser is not None else {}
            cfg = str(Path(str(parsed.get('config_path') or '')).resolve()) if parsed.get('config_path') else ''
            if cfg != normalized_config:
                continue
            out.append({
                'job_id': int(item.get('id') or 0),
                'public_job_id': item.get('public_job_id'),
                'status': item.get('status'),
                'created_at': item.get('created_at'),
                'next_attempt_at': item.get('next_attempt_at'),
                'retry_source': item.get('retry_source'),
                'trigger_type': parsed.get('trigger_type'),
                'connector_run_id': parsed.get('connector_run_id'),
                'dataset_keys': parsed.get('dataset_keys') or [],
                'retry_parent_run_id': parsed.get('retry_parent_run_id'),
                'retry_attempt_no': int(parsed.get('retry_attempt_no') or 0),
                'force': bool(parsed.get('force')),
                'scheduled_slot': parsed.get('scheduled_slot'),
            })
        return out



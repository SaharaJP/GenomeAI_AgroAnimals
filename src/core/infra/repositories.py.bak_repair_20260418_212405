                   data_version, qc_run, model_version, scoring_run, report_version, dedupe_key
            FROM alerts_v2
            WHERE {' AND '.join(where)}
            ORDER BY id DESC
            LIMIT ?
            """,
            tuple(args + [int(limit_alerts)]),
        ).fetchall()
        return [dict(r) for r in rows]



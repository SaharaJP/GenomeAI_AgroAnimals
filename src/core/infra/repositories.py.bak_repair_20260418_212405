@dataclass
class BaseSqlRepo:
    conn: Any
    backend: DbBackend | None = None

    def __post_init__(self) -> None:
        if self.backend is None:
            self.backend = resolve_db_backend(conn=self.conn)

    def _ph(self, count: int) -> str:
        return self.backend.placeholders(count)

    def ping(self) -> bool:
        self.conn.execute("SELECT 1").fetchone()
        return True


class DecisionsRepo(BaseSqlRepo):
    def append(self, *, tenant_id: str, decision_id: str, created_at: str, payload: dict[str, Any]) -> str:
        self.conn.execute(
            """
            INSERT INTO decision_log_v2(
              decision_id, tenant_id, created_at,
              recommendation_id, action, user_id, username, reason, comment,
              related_alert,
              object_type, object_id, farm_id, group_id,
              data_version, model_version, report_version, qc_run, scoring_run,
              metadata_json
            ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
            """,
            (
                decision_id,
                tenant_id,
                created_at,
                payload.get("recommendation_id"),
                payload.get("action"),
                int(payload.get("user_id") or 0),
                str(payload.get("username") or ""),
                payload.get("reason"),
                payload.get("comment"),
                payload.get("related_alert"),
                payload.get("object_type"),
                payload.get("object_id"),
                payload.get("farm_id"),
                payload.get("group_id"),
                payload.get("data_version"),
                payload.get("model_version"),
                payload.get("report_version"),
                payload.get("qc_run"),
                payload.get("scoring_run"),
                json.dumps(payload.get("metadata") or {}, ensure_ascii=False),
            ),
        )
        self.conn.commit()
        return decision_id

    @staticmethod
    def _row_to_dict(row: Any) -> Optional[dict[str, Any]]:
        if not row:
            return None
        d = dict(row)
        metadata_raw = d.get("metadata_json")
        if isinstance(metadata_raw, (dict, list)):
            d["metadata"] = metadata_raw
        elif isinstance(metadata_raw, (bytes, bytearray)):
            try:
                d["metadata"] = json.loads(metadata_raw.decode("utf-8", errors="replace") or "{}")
            except Exception:
                d["metadata"] = {}
        else:
            try:
                d["metadata"] = json.loads(metadata_raw or "{}")
            except Exception:
                d["metadata"] = {}
        d.pop("metadata_json", None)
        return d

    def get(self, *, tenant_id: str, decision_id: str) -> Optional[dict[str, Any]]:
        row = self.conn.execute(
            "SELECT * FROM decision_log_v2 WHERE tenant_id=? AND decision_id=?",
            (tenant_id, decision_id),
        ).fetchone()
        return self._row_to_dict(row)

    def list(self, *, tenant_id: str, filters: dict[str, Any], limit: int, offset: int) -> dict[str, Any]:
        where = ["tenant_id=?"]
        args: list[Any] = [tenant_id]

        def add(cond: str, val: Any) -> None:
            where.append(cond)
            args.append(val)

        for key in ("farm_id", "group_id", "object_type", "object_id", "related_alert", "recommendation_id", "action", "data_version", "model_version", "report_version"):
            value = filters.get(key)
            if value:
                add(f"{key}=?", value)
        if filters.get("user_id") is not None:
            add("user_id=?", int(filters.get("user_id")))
        q = filters.get("q")
        if q:
            where.append("(action LIKE ? OR reason LIKE ? OR comment LIKE ? OR username LIKE ?)")
            qq = f"%{q}%"
            args.extend([qq, qq, qq, qq])
        where_sql = " AND ".join(where)
        total = self.conn.execute(f"SELECT COUNT(*) AS n FROM decision_log_v2 WHERE {where_sql}", tuple(args)).fetchone()[0]
        rows = self.conn.execute(
            f"""
            SELECT * FROM decision_log_v2
            WHERE {where_sql}
            ORDER BY id DESC
            LIMIT ? OFFSET ?
            """,
            tuple(args + [int(limit), int(offset)]),
        ).fetchall()
        return {"total": int(total), "decisions": [self._row_to_dict(r) for r in rows if r]}

    def list_for_object(self, *, tenant_id: str, object_id: str, object_types: list[str], limit: int, offset: int) -> dict[str, Any]:
        if not object_id or not object_types:
            return {"total": 0, "decisions": []}
        ph = self._ph(len(object_types))
        where_sql = f"tenant_id=? AND object_id=? AND object_type IN ({ph})"
        args: list[Any] = [tenant_id, object_id] + list(object_types)
        total = self.conn.execute(f"SELECT COUNT(*) AS n FROM decision_log_v2 WHERE {where_sql}", tuple(args)).fetchone()[0]
        rows = self.conn.execute(
            f"""
            SELECT * FROM decision_log_v2
            WHERE {where_sql}
            ORDER BY id DESC
            LIMIT ? OFFSET ?
            """,
            tuple(args + [int(limit), int(offset)]),
        ).fetchall()
        return {"total": int(total), "decisions": [self._row_to_dict(r) for r in rows if r]}


class AlertsRepo(BaseSqlRepo):
    @staticmethod
    def row_to_dict(row: Any) -> Optional[dict[str, Any]]:
        if not row:
            return None
        d = dict(row)
        for key in ("attachments_json", "why_json", "what_to_do_json"):
            try:
                d[key] = json.loads(d.get(key) or ("[]" if key != "why_json" else "{}"))
            except Exception:
                d[key] = [] if key != "why_json" else {}
        d["attachments"] = d.pop("attachments_json")
        d["why"] = d.pop("why_json")
        d["what_to_do"] = d.pop("what_to_do_json")
        return d

    def list(self, *, tenant_id: str, filters: dict[str, Any], limit: int, offset: int) -> dict[str, Any]:
        wh = ["tenant_id=?"]
        args: list[Any] = [tenant_id]
        for key in ("status", "alert_type", "source", "object_type", "object_id"):
            value = filters.get(key)
            if value:
                wh.append(f"{key}=?")
                args.append(value)
        if filters.get("owner_user_id") is not None:
            wh.append("owner_user_id=?")
            args.append(int(filters.get("owner_user_id")))
        q = filters.get("q")
        if q:
            wh.append("(title LIKE ? OR cause LIKE ? OR alert_type LIKE ?)")
            args.extend([f"%{q}%", f"%{q}%", f"%{q}%"])
        where = " AND ".join(wh)
        rows = self.conn.execute(
            f"SELECT * FROM alerts_v2 WHERE {where} ORDER BY id DESC LIMIT ? OFFSET ?",
            tuple(args + [int(limit), int(offset)]),
        ).fetchall()
        total = self.conn.execute(f"SELECT COUNT(1) AS n FROM alerts_v2 WHERE {where}", tuple(args)).fetchone()[0]
        return {"total": int(total), "alerts": [self.row_to_dict(r) for r in rows if r]}

    def list_for_object(self, *, tenant_id: str, object_id: str, object_types: list[str], status: str | None, limit: int, offset: int) -> dict[str, Any]:
        if not object_id or not object_types:
            return {"total": 0, "alerts": []}
        ph = self._ph(len(object_types))
        wh = ["tenant_id=?", "object_id=?", f"object_type IN ({ph})"]
        args: list[Any] = [tenant_id, object_id] + list(object_types)
        if status:
            wh.append("status=?")
            args.append(status)
        where = " AND ".join(wh)
        total = self.conn.execute(f"SELECT COUNT(1) AS n FROM alerts_v2 WHERE {where}", tuple(args)).fetchone()[0]
        rows = self.conn.execute(
            f"SELECT * FROM alerts_v2 WHERE {where} ORDER BY id DESC LIMIT ? OFFSET ?",
            tuple(args + [int(limit), int(offset)]),
        ).fetchall()
        return {"total": int(total), "alerts": [self.row_to_dict(r) for r in rows if r]}

    def get(self, *, tenant_id: str, alert_id: str) -> Optional[dict[str, Any]]:
        row = self.conn.execute(
            "SELECT * FROM alerts_v2 WHERE tenant_id=? AND alert_id=?",
            (tenant_id, alert_id),
        ).fetchone()
        return self.row_to_dict(row)


    def fetch_status(self, *, tenant_id: str, task_id: str) -> Optional[str]:
        row = self.conn.execute(
            "SELECT status FROM tasks_v1 WHERE tenant_id=? AND task_id=?",
            (tenant_id, task_id),
        ).fetchone()
        return str(row["status"]) if row else None

    def list_rows(self, *, tenant_id: str, filters: dict[str, Any], limit: int, offset: int) -> dict[str, Any]:
        where = ["tenant_id=?"]
        args: list[Any] = [tenant_id]
        def add(cond: str, val: Any) -> None:
            where.append(cond)
            args.append(val)
        for key in ("status", "task_type", "related_alert", "object_type", "object_id", "worklist_type", "linked_decision_id", "linked_task_id"):
            value = filters.get(key)
            if value:
                add(f"{key}=?", value)
        if filters.get("owner_user_id") is not None:
            add("owner_user_id=?", int(filters.get("owner_user_id")))
        if filters.get("due_before"):
            add("due_at<=?", filters.get("due_before"))
        if filters.get("stage"):
            add("stage=?", filters.get("stage"))
        if filters.get("domain"):
            add("domain=?", filters.get("domain"))
        if filters.get("assignee_team"):
            add("assignee_team=?", str(filters.get("assignee_team")).strip())
        if filters.get("overdue_only"):
            where.append("status IN ('open','in_progress')")
            where.append("due_at IS NOT NULL")
            where.append("due_at < ?")
            args.append(filters.get("overdue_ts"))
        q = filters.get("q")
        if q:
            where.append("(title LIKE ? OR task_type LIKE ? OR closed_reason LIKE ?)")
            qq = f"%{q}%"
            args.extend([qq, qq, qq])
        where_sql = " AND ".join(where)
        total = self.conn.execute(f"SELECT COUNT(*) AS n FROM tasks_v1 WHERE {where_sql}", tuple(args)).fetchone()[0]
        rows = self.conn.execute(
            f"""
            SELECT * FROM tasks_v1
            WHERE {where_sql}
            ORDER BY
              CASE status WHEN 'open' THEN 0 WHEN 'in_progress' THEN 1 WHEN 'done' THEN 2 ELSE 3 END,
              due_at IS NULL,
              due_at ASC,
              priority ASC,
              id DESC
            LIMIT ? OFFSET ?
            """,
            tuple(args + [int(limit), int(offset)]),
        ).fetchall()
        return {"total": int(total), "rows": [dict(r) for r in rows]}

    def list_rows_for_object(self, *, tenant_id: str, object_id: str, object_types: list[str], limit: int, offset: int) -> dict[str, Any]:
        if not object_id or not object_types:

class CompletionOutcomesRepo(BaseSqlRepo):
    @staticmethod
    def _row_to_dict(row: Any) -> Optional[dict[str, Any]]:
        if not row:
            return None
        d = dict(row)
        try:
            d["metrics"] = json.loads(d.get("metrics_json") or "{}")
        except Exception:
            d["metrics"] = {}
        try:
            d["auto_actions"] = json.loads(d.get("auto_actions_json") or "{}")
        except Exception:
            d["auto_actions"] = {}
        d.pop("metrics_json", None)

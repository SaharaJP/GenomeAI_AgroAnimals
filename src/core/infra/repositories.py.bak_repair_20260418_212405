        try:
            row = self.conn.execute(
                "SELECT username FROM users_v2 WHERE tenant_id=? AND id=?",
                (tenant_id, int(user_id)),
            ).fetchone()
            if row and row[0]:
                return str(row[0])
        except Exception:
            pass
        try:
            row = self.conn.execute("SELECT username FROM users WHERE id=?", (int(user_id),)).fetchone()
            if row and row[0]:
                return str(row[0])
        except Exception:
            pass
        return f"user_{user_id}"


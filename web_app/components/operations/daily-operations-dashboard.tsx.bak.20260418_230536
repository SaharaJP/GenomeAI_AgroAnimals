'use client';
import { useEffect, useState } from 'react';
import Link from 'next/link';
import { MetricCard, Card } from '@/components/ui/card';
import { ExplainabilityBlock } from '@/components/ui/explainability-block';
import { AlertList } from '@/components/operations/alert-list';
import { WorklistList } from '@/components/ui/worklist-list';
import { DailyBriefPreview } from '@/components/operations/daily-brief-preview';
import { ScopeSummary } from '@/components/operations/scope-summary';
import { ParityEvidenceTable, type ParityEvidenceRow } from '@/components/operations/parity-evidence-table';
import { fetchDailyOperationsBundle, buildDailyOperationsViewModel, type DailyOperationsViewModel } from '@/lib/api/daily-operations';

const parityRows:ParityEvidenceRow[]=[
  {legacySurface:'Home / home_v3.py',reactSurface:'/daily-summary',parityLevel:'daily read parity',backendContract:'/api/app/v1/{alerts,worklists,planner,reports,decision-intelligence}',notes:'Daily summary, scope awareness and brief preview are available in React.'},
  {legacySurface:'Alert_Center_v2',reactSurface:'/alerts',parityLevel:'daily read parity',backendContract:'/api/app/v1/alerts',notes:'Alert triage cards, explainability and hooks are wired to canonical DTOs.'},
  {legacySurface:'Worklist_v1 / Daily_Worklists_By_Role',reactSurface:'/worklists',parityLevel:'daily read parity',backendContract:'/api/app/v1/worklists',notes:'Daily execution queues are available with linked action hooks.'},
  {legacySurface:'Operational_Planner',reactSurface:'/planner',parityLevel:'daily read parity',backendContract:'/api/app/v1/planner',notes:'Planner summary, weekly plans and overdue items are available in React.'},
  {legacySurface:'AI_Daily_Brief',reactSurface:'/daily-summary',parityLevel:'preview parity',backendContract:'derived from canonical daily DTO bundle',notes:'Preview only; full formal replacement still needs future migration evidence.'},
];

export function DailyOperationsDashboard(){const [data,setData]=useState<DailyOperationsViewModel|null>(null);const [error,setError]=useState<string|null>(null);useEffect(()=>{void fetchDailyOperationsBundle().then(bundle=>setData(buildDailyOperationsViewModel(bundle))).catch(err=>setError(err instanceof Error?err.message:'Failed to load daily operations'))},[]); return <div className="grid"><div className="topbar"><div><h1 className="page-title">Home / daily summary</h1><p className="page-subtitle">React operational replacement surface for start-of-day workflow. Active start-of-day workflow for the current product contour.</p></div></div><ExplainabilityBlock reasons={['The daily summary is assembled from canonical backend DTOs only.','Linked actions, decision hooks and feedback hooks remain server-governed.','Multi-site and single-farm modes use the same scope metadata from auth/session contracts. This daily summary keeps explicit multi-site visibility in React.']} />{error?<div className="card error-text">{error}</div>:null}{!data?<div className="card">Loading daily summary…</div>:<><div className="grid grid-3"><MetricCard title="Open alerts" value={data.totals.alertsOpen} /><MetricCard title="Critical alerts" value={data.totals.alertsCritical} /><MetricCard title="Open worklists" value={data.totals.worklistsOpen} /><MetricCard title="Overdue worklists" value={data.totals.worklistsOverdue} /><MetricCard title="Pending approvals" value={data.totals.pendingApprovals} /><MetricCard title="Acceptance rate" value={`${Math.round(data.totals.feedbackAcceptanceRate*100)}%`} /></div><div className="grid grid-2"><ScopeSummary scope={data.scope} /><DailyBriefPreview brief={data.brief} /></div>{data.farms.length>0?<Card><h3 className="card-title">Farm/site visibility</h3><div className="table-wrap"><table className="table"><thead><tr><th>Farm</th><th>Open alerts</th><th>Open tasks</th><th>Overdue</th></tr></thead><tbody>{data.farms.map(item=><tr key={item.farmId}><td>{item.label}</td><td>{item.alerts}</td><td>{item.tasks}</td><td>{item.overdue}</td></tr>)}</tbody></table></div></Card>:null}<Card><h3 className="card-title">Linked actions</h3><div className="linked-actions-grid"><Link className="linked-action-card" href="/alerts"><div className="linked-action-count">{data.totals.alertsOpen}</div><div><div className="linked-action-title">Alerts triage</div><div className="linked-action-caption">Resolve daily deviations with explainability hooks.</div></div></Link><Link className="linked-action-card" href="/worklists"><div className="linked-action-count">{data.totals.worklistsOpen}</div><div><div className="linked-action-title">Worklists</div><div className="linked-action-caption">Open role queues and linked tasks.</div></div></Link><Link className="linked-action-card" href="/planner"><div className="linked-action-count">{data.totals.pendingApprovals}</div><div><div className="linked-action-title">Operational planner</div><div className="linked-action-caption">Review weekly plans and overdue backlog.</div></div></Link><Link className="linked-action-card" href="/decisions"><div className="linked-action-count">{data.totals.linkedDecisions}</div><div><div className="linked-action-title">Decision / feedback trail</div><div className="linked-action-caption">Open governance and feedback evidence.</div></div></Link></div></Card><div className="grid grid-2"><div><h2 className="section-title">Priority alerts</h2><AlertList items={data.highlightAlerts} /></div><div><h2 className="section-title">Priority worklists</h2><WorklistList items={data.highlightWorklists} /></div></div><ParityEvidenceTable rows={parityRows} /></>}</div>}

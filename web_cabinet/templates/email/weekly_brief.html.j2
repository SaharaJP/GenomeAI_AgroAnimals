<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ brief.title }}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 0; background: #f5f5f5; color: #1e1e1e; }
  .wrapper { max-width: 680px; margin: 0 auto; background: #ffffff; }
  .header { background: #009688; color: #ffffff; padding: 24px 32px; }
  .header h1 { margin: 0 0 4px; font-size: 22px; font-weight: 700; }
  .header p { margin: 0; font-size: 13px; opacity: 0.85; }
  .content { padding: 24px 32px; }
  .summary-box { background: #e0f2f1; border-left: 4px solid #009688; padding: 14px 18px; border-radius: 4px; margin-bottom: 24px; font-size: 14px; line-height: 1.6; }
  .section-title { font-size: 16px; font-weight: 700; color: #009688; border-bottom: 2px solid #e0f2f1; padding-bottom: 6px; margin: 24px 0 12px; }
  .section-narrative { font-size: 13px; line-height: 1.7; color: #333; margin-bottom: 10px; }
  .highlight-list { list-style: none; padding: 0; margin: 0 0 12px; }
  .highlight-list li { font-size: 12px; padding: 4px 0 4px 18px; position: relative; color: #555; }
  .highlight-list li::before { content: "•"; position: absolute; left: 4px; color: #009688; font-weight: bold; }
  .kpi-table { width: 100%; border-collapse: collapse; margin: 12px 0 24px; font-size: 12px; }
  .kpi-table th { background: #009688; color: #fff; padding: 8px 10px; text-align: left; }
  .kpi-table td { padding: 7px 10px; border-bottom: 1px solid #e0e0e0; }
  .kpi-table tr:nth-child(even) td { background: #f0faf9; }
  .delta-neg { color: #d32f2f; font-weight: 600; }
  .delta-pos { color: #388e3c; font-weight: 600; }
  .rec-block { border: 1px solid #e0e0e0; border-radius: 6px; padding: 12px 16px; margin-bottom: 12px; }
  .rec-priority { display: inline-block; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 3px; margin-bottom: 6px; text-transform: uppercase; }
  .rec-priority.high { background: #ffebee; color: #c62828; }
  .rec-priority.medium { background: #fff3e0; color: #e65100; }
  .rec-priority.low { background: #e8f5e9; color: #2e7d32; }
  .rec-title { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
  .rec-rationale { font-size: 12px; color: #666; margin-bottom: 3px; }
  .rec-outcome { font-size: 12px; color: #009688; }
  .anomaly { padding: 8px 12px; border-radius: 4px; margin-bottom: 8px; font-size: 12px; }
  .anomaly.critical { background: #ffebee; border-left: 3px solid #f44336; }
  .anomaly.warning { background: #fff3e0; border-left: 3px solid #ff9800; }
  .anomaly.info { background: #e3f2fd; border-left: 3px solid #2196f3; }
  .footer { background: #f5f5f5; padding: 16px 32px; font-size: 11px; color: #999; text-align: center; border-top: 1px solid #e0e0e0; }
</style>
</head>
<body>
<div class="wrapper">
  <!-- Header -->
  <div class="header">
    <h1>{{ brief.title }}</h1>
    <p>GenomeAI · Ферма: {{ brief.farm_id }} · Период: {{ brief.period.start }} — {{ brief.period.end }}</p>
  </div>

  <div class="content">
    <!-- Executive Summary -->
    <div class="summary-box">{{ brief.executive_summary }}</div>

    <!-- KPI Table -->
    {% if brief.kpi_table %}
    <div class="section-title">KPI недели</div>
    <table class="kpi-table">
      <tr>
        <th>Показатель</th>
        <th>Факт</th>
        <th>Пред. период</th>
        <th>Δ%</th>
        <th>Ед.</th>
      </tr>
      {% for kpi_name, kpi in brief.kpi_table.items() %}
      {% if kpi is mapping %}
      <tr>
        <td>{{ kpi_name }}</td>
        <td>{{ kpi.get('value', '—') }}</td>
        <td>{{ kpi.get('prev_period', '—') }}</td>
        <td class="{{ 'delta-neg' if (kpi.get('delta_pct') or 0) < 0 else 'delta-pos' }}">
          {% if kpi.get('delta_pct') is not none %}{{ '%+.1f' | format(kpi.get('delta_pct', 0)) }}%{% else %}—{% endif %}
        </td>
        <td>{{ kpi.get('unit', '') }}</td>
      </tr>
      {% endif %}
      {% endfor %}
    </table>
    {% endif %}

    <!-- Sections -->
    {% for section in brief.sections %}
    <div class="section-title">{{ section.heading }}</div>
    <div class="section-narrative">{{ section.narrative | replace('\n\n', '</div><div class="section-narrative">') | safe }}</div>
    {% if section.highlights %}
    <ul class="highlight-list">
      {% for h in section.highlights %}<li>{{ h }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% endfor %}

    <!-- Anomalies -->
    {% if brief.anomalies_detected %}
    <div class="section-title">Выявленные аномалии</div>
    {% for anomaly in brief.anomalies_detected %}
    <div class="anomaly {{ anomaly.severity }}">
      <strong>[{{ anomaly.severity | upper }}]</strong> {{ anomaly.description }}
      {% if anomaly.evidence_id %}<span style="opacity:0.6; font-size:11px"> [{{ anomaly.evidence_id }}]</span>{% endif %}
    </div>
    {% endfor %}
    {% endif %}

    <!-- Recommendations -->
    {% if brief.key_recommendations %}
    <div class="section-title">Рекомендации на следующую неделю</div>
    {% for rec in brief.key_recommendations %}
    <div class="rec-block">
      <span class="rec-priority {{ rec.priority }}">{{ rec.priority }}</span>
      <div class="rec-title">{{ rec.recommendation }}</div>
      <div class="rec-rationale">Обоснование: {{ rec.rationale }}</div>
      <div class="rec-outcome">Ожидаемый результат: {{ rec.expected_outcome }}</div>
    </div>
    {% endfor %}
    {% endif %}
  </div>

  <!-- Footer -->
  <div class="footer">
    GenomeAI AgroAnimals · Модель: {{ brief.generation_model }} ·
    Сгенерирован: {{ brief.generated_at_utc.strftime('%Y-%m-%d %H:%M UTC') if brief.generated_at_utc else '' }}<br>
    Этот отчёт создан автоматически ИИ-системой GenomeAI.
  </div>
</div>
</body>
</html>

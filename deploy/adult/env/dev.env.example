GENOMEAI_HTTP_PORT=8080
GENOMEAI_HTTPS_PORT=8443
GENOMEAI_WEB_BASE_URL=http://localhost:8080
GENOMEAI_API_BASE_URL=http://backend-api:8000
GENOMEAI_RUNTIME_STORAGE_BACKEND=postgres
GENOMEAI_JOB_QUEUE_BACKEND=redis
GENOMEAI_REDIS_DSN=redis://redis:6379/0
GENOMEAI_WEB_SECRET=dev-secret-change-me
GENOMEAI_RUNTIME_POSTGRES_DSN=postgresql://genomeai:${POSTGRES_PASSWORD:-genomeai-change-me}@postgres:5432/genomeai
GENOMEAI_AUTH_ACCESS_TTL_SEC=900
GENOMEAI_AUTH_REFRESH_TTL_SEC=2592000
GENOMEAI_INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me
GENOMEAI_AUTH_SIGNING_KEY=dev-auth-signing-key-change-me
GENOMEAI_AUTH_REFRESH_HMAC_KEY=dev-auth-refresh-hmac-key-change-me
POSTGRES_DB=genomeai
POSTGRES_USER=genomeai
POSTGRES_PASSWORD=genomeai-change-me
REDIS_PASSWORD=redis-change-me
MINIO_ROOT_USER=genomeai
MINIO_ROOT_PASSWORD=genomeai-change-me
MINIO_BUCKET_ARTIFACTS=genomeai-artifacts

# GenomeAI AgroAnimals deploy env example
# Use with: docker compose --env-file /opt/genomeai/.env --profile <dev|prod> -f deploy/docker-compose.yml up -d --build

# --- Profile ---
GENOMEAI_DEPLOY_PROFILE=dev
GENOMEAI_ENV=dev
GENOMEAI_WEB_PORT=8000
GENOMEAI_WEB_UI_PORT=3000
# Optional public URL shown in fallback banners / support docs:
# GENOMEAI_WEB_PUBLIC_URL=http://localhost:3000

# --- Session secret ---
# Dev: can be overridden here. Prod: must be changed or passed through *_FILE.
GENOMEAI_WEB_SECRET=change-me-very-long-secret
# Alternative for prod/on-prem secrets files:
# GENOMEAI_WEB_SECRET_FILE=/run/secrets/genomeai_web_secret

# --- Optional LLM secret ---
# OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# --- Guardrails ---
GENOMEAI_WEB_MAX_UPLOAD_MB=200
GENOMEAI_WEB_MAX_MAPPING_MB=5
GENOMEAI_JOB_TIMEOUT_SEC=1800
GENOMEAI_CONNECTOR_RECOVERY_QUEUE_LIMIT=5
